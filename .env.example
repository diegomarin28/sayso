# Copiá a .env.local (no se sube a git)
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ELEVENLABS_API_KEY=
# Opcional: voz de ElevenLabs para el experto (si falta, KqSsYz0buWgkvSbaGn1n, la elegida por el grupo)
ELEVENLABS_VOICE_ID=
# Freno de gasto de la IA (lib/ia/freno.ts). IA_APAGADA=1 pausa toda la IA; IA_LIMITE_USD_DIA=5 la pausa
# cuando el gasto estimado del día llega a 5 USD (sin valor = sin límite). Las rutas devuelven 503 "IA en pausa".
IA_APAGADA=
IA_LIMITE_USD_DIA=
# Opcional: zona horaria del "día" del límite (por defecto America/Argentina/Buenos_Aires)
IA_ZONA_HORARIA=
# Opcional: velocidad de la voz del experto (0.7 a 1.2; por defecto 1.15)
ELEVENLABS_VELOCIDAD=
