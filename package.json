{
  "name": "sayso",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "modelos:comprimir": "node assets/models/comprimir.mjs public/models/piezas",
    "modelos:piezas": "blender -b --factory-startup --python assets/models/blender/piezas.py -- --salida public/models/piezas && npm run modelos:comprimir",
    "modelos:dispositivos": "blender -b --factory-startup --python assets/models/blender/dispositivos.py -- --salida public/models/piezas && npm run modelos:comprimir",
    "modelos:cotidianos": "blender -b --factory-startup --python assets/models/blender/cotidianos.py -- --salida public/models/piezas && npm run modelos:comprimir",
    "modelos:facultad": "blender -b --factory-startup --python assets/models/blender/facultad.py -- --salida public/models/piezas && npm run modelos:comprimir",
    "modelos:campus": "blender -b --factory-startup --python assets/models/blender/campus.py -- --salida public/models/piezas",
    "modelos:demo": "python3 assets/models/blender/publicar_demo.py",
    "modelos:decodificar": "node --import tsx assets/models/blender/decodificar.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@elevenlabs/client": "1.26.0",
    "@napi-rs/canvas": "1.0.9",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "heic-to": "1.6.5",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
